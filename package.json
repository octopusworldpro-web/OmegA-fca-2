{
  "name": "@nirzon-islam/omega-fca",
  "version": "0.1.7",
  "description": "OmegA Bot Facebook integration library, developed and maintained by NirZon",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:syntax": "node -e \"const fs=require('node:fs');const path=require('node:path');const cp=require('node:child_process');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(d,e.name)):[path.join(d,e.name)]);for(const f of ['index.js',...walk('src'),...walk('test'),...walk('examples'),...walk('tools')].filter(f=>f.endsWith('.js'))){const r=cp.spawnSync(process.execPath,['--check',f],{stdio:'inherit'});if(r.status!==0)process.exit(r.status||1)}\"",
    "prepublishOnly": "npm test && npm run test:syntax",
    "test:appstate": "node examples/appstate-session-check.js",
    "test:messenger-mqtt": "node examples/messenger-mqtt-smoke.js",
    "capture:browser": "node tools/browser-capture.js",
    "test:types": "node --test test/types.test.js"
  },
  "license": "MIT",
  "keywords": [
    "facebook",
    "messenger",
    "fca",
    "nodejs",
    "omega"
  ],
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "examples/",
    "README.md",
    "LICENSE",
    "docs/META-MESSENGER-TRANSPORT.md",
    "docs/FACEBOOK-MQTT-TRANSPORT.md",
    "docs/DEPLOYMENT.md",
    "docs/PROTOCOL-EVIDENCE.md",
    "docs/AUTHENTICATION-ATTEMPT.md",
    "docs/IMPLEMENTATION-STATUS.md",
    "docs/ARCHITECTURE.md",
    "docs/GOATBOT-COMPATIBILITY-MATRIX.md",
    "docs/GOATBOT-INTEGRATION-AUDIT.md",
    "docs/GOATBOT-CALLSITE-INVENTORY.md",
    "docs/NTKHANG-REFERENCE-STUDY.md",
    "docs/SAFE-DIAGNOSTICS.md",
    "docs/REALTIME-FRAME-EVIDENCE.md",
    "docs/NESTED-REALTIME-PAYLOAD.md",
    "tools/",
    "docs/BROWSER-CAPTURE.md",
    "docs/GOATBOT-EVENT-COMPATIBILITY.md",
    "docs/GOATBOT-ATTACHMENT-COMPATIBILITY.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/E2EE.md",
    "docs/TYPESCRIPT.md",
    "docs/PRERELEASE-PUBLISHING.md"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "author": "NirZon",
  "dependencies": {
    "ws": "^8.18.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nirzon-islam/OmegA-FCA.git"
  }
}
